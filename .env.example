# ---------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
#   Windows  : copy .env.example .env
#   Mac/Linux: cp .env.example .env
# .env is in .gitignore - never commit it.
# ---------------------------------------------------------------

# --- Supabase PostgreSQL (REQUIRED) --------------------------------
# Supabase dashboard -> your project -> Project Settings -> Database
#   -> Connection string -> URI, and tick "Use connection pooling".
# It looks like this (the ? is your own password):
#
#   postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Use the POOLER host (…pooler.supabase.com). The direct db.<ref>.supabase.co
# host is IPv6-only and will not connect from most home networks.
DATABASE_URL=

# Supabase requires TLS. Leave this alone unless you are pointing at a
# plain PostgreSQL server on your own machine, where you would set false.
DATABASE_SSL=true

# --- App -----------------------------------------------------------
PORT=4000

# Secret used to sign the login cookie - any long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# How long a login session lasts, in seconds (default 7 days)
JWT_EXPIRES_IN=604800

# Shown in the emails written to the candidate outbox
COMPANY_NAME=Altrium

# Set to false to let a candidate move on without feedback for the
# current stage. The brief says they should be blocked, so leave it on.
REQUIRE_FEEDBACK_TO_ADVANCE=true

# --- Optional: "Sign in with Google" -------------------------------
# Leave blank to hide the Google button; email + password still works.
# https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
CLIENT_URL=http://localhost:5173

# --- Optional: automated tests --------------------------------------
# The tests create and drop their own schema, so they never touch your
# real data. Leave blank to reuse DATABASE_URL.
TEST_DATABASE_URL=

# --- Real email via Resend (optional, preferred) ----------------------
# An HTTP email API - no SMTP server, works from networks that block
# outbound mail ports. Takes precedence over the SMTP settings below.
#
# IMPORTANT: on a free account with no verified domain, Resend delivers
# ONLY to the address that owns the account. Every other recipient comes
# back 403, and the app records that against the outbox entry. To reach
# real candidate addresses, verify a domain at resend.com/domains and
# change RESEND_FROM_EMAIL to use it - or use Gmail SMTP below, which
# has no such restriction.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Real email via SMTP (optional) -----------------------------------
# Leave SMTP_HOST blank and nothing is sent: every message still lands in
# the outbox for HR to send by hand, exactly as before.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters
# into SMTP_PASS. Your normal Gmail password will NOT work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- CV storage (optional) -------------------------------------------
# Leave SUPABASE_URL blank and CVs are written to server/uploads, as
# before. Set both and they go to a PRIVATE Supabase Storage bucket
# instead, which the app creates on first run if it does not exist.
#
# Supabase Dashboard -> Project Settings -> API
#   SUPABASE_URL              = the Project URL
#   SUPABASE_SERVICE_ROLE_KEY = the service_role key (NOT the anon key)
#
# The service role key bypasses row-level security. It is read on the
# server only and never reaches the browser. Do not commit it.
SUPABASE_URL=https://mxahawsqubspavtgrgia.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im14YWhhd3NxdWJzcGF2dGdyZ2lhIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Nzc2NDQ4NCwiZXhwIjoyMTAzMzQwNDg0fQ.wNRDTGzTl9t3ZrnlWNOwBstzxzJfxsc5gzJfh3plLV8
SUPABASE_CV_BUCKET=candidate-cvs
